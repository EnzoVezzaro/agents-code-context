# ACC — API keys
#
# Copy this file to `.env` (gitignored) and fill in the keys you want.
# ACC reads keys from the environment; the `acc ai` command writes them
# to `.env` automatically as ACC_<PROVIDER_ID>_KEY.
#
#   cp .env.example .env
#
# ⚠️  Never commit the real .env file.

# --- ACC-managed keys (written by `acc ai add`) ---
# One per provider id, referenced as api_key_env in the provider config.
# ACC_OPENAI_KEY=
# ACC_ANTHROPIC_KEY=
# ACC_GOOGLE_KEY=
# ACC_OPENROUTER_KEY=
# ACC_NVIDIA_KEY=
# ACC_GROQ_KEY=
# ACC_TOGETHER_KEY=

# --- Conventional keys (used directly via api_key_env) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=

# --- Live test keys (used by the ACC test suite; never commit real values) ---
# ACC_NVIDIA_KEY=
# ACC_GEMINI_KEY=
# ACC_OPENROUTER_KEY=
