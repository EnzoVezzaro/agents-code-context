# Git
.git/

# macOS
.DS_Store

# Build outputs (language-specific; safe defaults)
target/
node_modules/
dist/
build/

# Docs site (VitePress) — build output and dependency cache
# The site is built directly from docs/; see docs/.vitepress/config.ts
docs/.vitepress/dist/
docs/.vitepress/cache/

# Dependency locks
*.lock
package-lock.json
yarn.lock
Cargo.lock
go.sum
# The docs site lockfile IS committed — the Pages deploy uses `npm ci`
# (.github/workflows/pages.yml) and needs a lockfile to install from.
!docs/package-lock.json

# ACC durable memory — local, agent-written, never committed.
# See docs/08-memory-semantics.md.
.acc-memory.md
.acc/state

# ACC drift report — regenerated by `acc engine` on every run.
# See docs/05-cli-commands.md (acc engine).
ACC_WARN.md

# Secrets — API keys live in the environment, never in the repo.
.env
.env.*
!.env.example

# Engine trigger state — local derived state (last processed commit /
# change snapshot), never committed.
.acc/state/

# ABA — standalone project (own git repo), never pushed with ACC.
# See aba/ for its own repo, package, and license.
aba/
