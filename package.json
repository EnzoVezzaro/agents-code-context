{
  "name": "acc-code-context",
  "version": "0.6.7-dev",
  "description": "ACC — Agent Code Context. A convention + optional CLI that makes software repositories agent-native, navigable, and self-describing.",
  "license": "MIT",
  "type": "commonjs",
  "main": "bin/acc.js",
  "bin": {
    "acc": "bin/acc.js"
  },
  "files": [
    "bin",
    "lib",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.95",
    "@ai-sdk/google": "^2.0.88",
    "@ai-sdk/openai": "^2.0.118",
    "acc-battle-arena": "^0.1.8",
    "ai": "^5.0.237",
